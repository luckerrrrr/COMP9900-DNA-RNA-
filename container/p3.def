Bootstrap: docker
From: pytorch/pytorch:2.0.1-cuda11.7-cudnn8-runtime

%files
    requirements.txt /opt/requirements.txt

%post
    set -e
    apt-get update
    apt-get install -y git
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    # requirements.txt no longer includes torch to avoid downloading large wheels
    pip install --no-cache-dir -r /opt/requirements.txt

    # Install GPN during build (pin to a commit for stability if needed)
    pip install --no-cache-dir git+https://github.com/songlab-cal/gpn.git

    # Clean up pip cache to reduce image size
    pip cache purge || true
    rm -f /opt/requirements.txt

%environment
    export LC_ALL=C
    export PYTHONUNBUFFERED=1

%runscript
    # Allows: apptainer run image.sif path/to/script.py [args...]
    exec python "$@"
