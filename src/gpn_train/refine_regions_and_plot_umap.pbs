#!/bin/bash
#PBS -N refine_regions_umap
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -l walltime=1:00:00
#PBS -j oe
#PBS -o refine_regions_and_plot_umap.log

module load singularity || true

cd /home/z5618581/capstone-project-25t3-9900-f09c-donut

echo "Starting refine regions + UMAP..."
echo "Job ID: $PBS_JOBID"
echo "Start time: $(date)"

if command -v singularity >/dev/null 2>&1 && [ -f gpn.sif ]; then
  singularity exec gpn.sif python3 src/gpn_train/refine_regions_and_plot_umap.py
else
  python3 src/gpn_train/refine_regions_and_plot_umap.py
fi

echo "Completed at $(date)"


