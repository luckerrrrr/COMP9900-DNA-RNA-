#!/bin/bash
#PBS -N human_umap_new
#PBS -l select=1:ncpus=4:mem=32gb:ngpus=1
#PBS -l walltime=4:00:00
#PBS -j oe
#PBS -o human_umap_new.log
#PBS -M z5618581@unsw.edu.au
#PBS -m ae

# Human GPN UMAP Generation - NEW VERSION (Using gene_type labels)
# According to supervisor's suggestion: use gene_type from GTF instead of refined_region

# Load modules
module load singularity 2>/dev/null || true

# Set working directory
cd /home/z5618581/capstone-project-25t3-9900-f09c-donut || exit 1

echo "=========================================="
echo "Human GPN Model - UMAP by Gene Type (NEW)"
echo "=========================================="
echo "Job ID: $PBS_JOBID"
echo "Node: $(hostname)"
echo "Start time: $(date)"
echo "Working directory: $(pwd)"
echo ""
echo "Note: This version uses gene_type labels"
echo "      (protein_coding, lncRNA, TEC, pseudogene, other)"
echo "      instead of refined_region labels"
echo "      (CDS, UTR, exon, intron, intergenic)"
echo ""

# Check if container exists
CONTAINER="/srv/scratch/$USER/images/p3.sif"
if [ ! -f "$CONTAINER" ]; then
    echo "Error: Container not found: $CONTAINER"
    exit 1
fi
echo "? Container found: $CONTAINER"

# Check if model exists
MODEL_PATH="output/human_gpn_pretrained_real_gpn"
if [ ! -d "$MODEL_PATH" ]; then
    echo "Error: Human model not found: $MODEL_PATH"
    exit 1
fi
echo "? Model found: $MODEL_PATH"

# Check if FASTA exists
FASTA_PATH="dataset/Homo_sapiens.GRCh38.dna.chromosome.1.fa"
if [ ! -f "$FASTA_PATH" ]; then
    echo "Error: FASTA not found: $FASTA_PATH"
    exit 1
fi
echo "? FASTA found: $FASTA_PATH"

# Check if windows CSV exists
WINDOWS_CSV="chr1_windows.csv"
if [ ! -f "$WINDOWS_CSV" ]; then
    echo "Error: Windows CSV not found: $WINDOWS_CSV"
    exit 1
fi
echo "? Windows CSV found: $WINDOWS_CSV"

# Check if GTF exists
GTF_PATH="dataset/gencode.v38.basic.annotation.gtf"
if [ ! -f "$GTF_PATH" ]; then
    echo "Error: GTF not found: $GTF_PATH"
    exit 1
fi
echo "? GTF found: $GTF_PATH"

# Check GPU
echo ""
echo "Checking GPU..."
nvidia-smi || echo "Warning: nvidia-smi not available"

echo ""
echo "=========================================="
echo "Starting UMAP generation (gene_type)..."
echo "This version:"
echo "  ? Uses gene_type from GTF as labels"
echo "  ? Groups into: protein_coding, lncRNA,"
echo "    TEC, pseudogene, other"
echo "  ? More biological interpretation"
echo "  ? Better for cross-species comparison"
echo "=========================================="
echo ""

# Run the NEW script inside container
apptainer exec --nv "$CONTAINER" python3 src/gpn_train/human_generate_umap_new.py

EXIT_CODE=$?

echo ""
echo "=========================================="
echo "Job completed at $(date)"
echo "Exit code: $EXIT_CODE"
echo "=========================================="

if [ $EXIT_CODE -eq 0 ]; then
    echo ""
    echo "? UMAP generation successful!"
    echo ""
    echo "Results saved in: output/human_umap/"
    echo ""
    echo "Files:"
    echo "  ? human_umap_visualization.png  - UMAP plot by gene type"
    echo "  ? window_embeddings.npy         - 768-dim embeddings"
    echo "  ? umap_coordinates.npy          - UMAP 2D coordinates"
    echo "  ? windows_with_umap_refined.csv - Data with UMAP + gene types"
    echo "  ? umap_summary.json             - Summary with gene_type_counts"
    echo ""
    echo "Gene type categories:"
    echo "  ? protein_coding (blue)"
    echo "  ? lncRNA (pink)"
    echo "  ? TEC (green)"
    echo "  ? pseudogene (gray)"
    echo "  ? other (orange)"
    echo ""
    
    # Show output files
    if [ -d "output/human_umap" ]; then
        echo "Output files:"
        ls -lh output/human_umap/
    fi
    
    # Show gene type distribution if summary exists
    if [ -f "output/human_umap/umap_summary.json" ]; then
        echo ""
        echo "Gene type distribution:"
        python3 -c "import json; data=json.load(open('output/human_umap/umap_summary.json')); print(json.dumps(data.get('gene_type_counts', {}), indent=2))" 2>/dev/null || echo "(Run python to see distribution)"
    fi
else
    echo ""
    echo "? UMAP generation failed!"
    echo "Check the log above for errors"
fi

exit $EXIT_CODE





